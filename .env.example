# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get from: https://neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY="your-tmdb-api-key"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Cinephilers <no-reply@cinephilers.app>"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://cinephilers.app"
PORT="9002"

# ─── AI (optional) ─────────────────────────────────────────────────────────────
GOOGLE_GENAI_API_KEY="your-google-genai-key"
