generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  CRITIC
}

enum MediaType {
  MOVIE
  SHOW
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  passwordHash   String
  displayName    String?
  avatarUrl      String?
  bio            String?  @db.VarChar(300)
  favoriteGenres String[]
  country        String?
  // IANA zone name reported by the browser ("Europe/Tirane"), so the SERVER can
  // work out what day it is for this person. Today's Pick and the streak badge
  // both turn on "their day", and badges are computed on a background refresh
  // with no browser present — so the answer has to live here rather than being
  // sent up with each request. Null until a device reports one; everything falls
  // back to UTC in the meantime, which is the behaviour that existed before.
  timezone       String?
  role           Role     @default(USER)
  isVerified     Boolean  @default(false)
  isPrivate      Boolean  @default(false)
  isBanned       Boolean  @default(false)
  ratingsCount   Int      @default(0)
  reviewsCount   Int      @default(0)
  // When this account was shown the Founder welcome. Null means never, which is
  // what makes the moment happen exactly once on any device — the genre skip is
  // per-device on purpose, this is the opposite: a first sign-in happens once in
  // a lifetime, so it is remembered on the account and not in localStorage.
  welcomedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // emailVerificationToken / passwordResetToken hold SHA-256 digests of the
  // emailed tokens (see src/lib/token-hash.ts), never the raw values.
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  tokenVersion             Int       @default(0)

  // Per-user list sort preferences (Refine) — { history, ratings, watchlist,
  // list } → RefineValue. Stored on the account so they survive a browser-data
  // clear and stay consistent across devices.
  listPrefs Json?

  ratings               Rating[]
  reviews               Review[]
  watched               WatchedItem[]
  watchEvents           WatchEvent[]
  watchlist             WatchlistItem[]
  favorites             Favorite[]
  lists                 CustomList[]
  badgeSnapshot         UserBadges?
  reviewLikes           ReviewLike[]
  watchedEpisodes       WatchedEpisode[]
  followers             Follow[]         @relation("Following")
  following             Follow[]         @relation("Follower")
  notifications         Notification[]   @relation("NotificationRecipient")
  sentNotifications     Notification[]   @relation("NotificationSender")
  sentRequests          FollowRequest[]  @relation("SentRequests")
  receivedRequests      FollowRequest[]  @relation("ReceivedRequests")
  reviewComments        ReviewComment[]
  reports               Report[]
  importActivities      ImportActivity[]
  hiddenActivities      HiddenActivity[]
  activityLikesGiven    ActivityLike[]   @relation("ActivityLiker")
  activityLikesReceived ActivityLike[]   @relation("ActivityOwner")
  dailyPicks            DailyPick[]
}

model Rating {
  id        String    @id @default(uuid())
  userId    String
  tmdbId    String
  mediaType MediaType
  score     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId])
}

// Per-title rating aggregate (the "Cinephilers score"). Stores only count + sum
// so updates are race-safe atomic increments; the average is derived (sum/count)
// at read time. Maintained by the rating mutation routes; seeded by a one-time
// backfill from the Rating table.
model MovieRating {
  tmdbId    String
  mediaType MediaType
  count     Int       @default(0)
  sum       Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@id([tmdbId, mediaType])
}

model Review {
  id              String    @id @default(uuid())
  userId          String
  tmdbId          String
  mediaType       MediaType
  body            String
  containsSpoiler Boolean   @default(false)
  likesCount      Int       @default(0)
  // Soft-delete: a moderator "removes" a reported review by setting hidden=true.
  // Hidden reviews are excluded from every public read path but the row survives
  // so the removal can be reversed (Restore) from the admin panel.
  hidden          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    ReviewLike[]
  comments ReviewComment[]

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId])
}

// The user's "Today's Pick" — one released, unwatched film chosen from their
// watchlist per day (computed client-side, seeded so it can't be rerolled).
// Recorded so followers' feeds can show it — a public commitment to watch it.
model DailyPick {
  id        String    @id @default(uuid())
  userId    String
  tmdbId    String
  mediaType MediaType
  day       String // server UTC day, YYYY-MM-DD — one pick per user per day
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([createdAt])
}

// A like on a feed activity card (watched / rewatched / rated / reviewed).
// Feed items have no single row id across their source tables, so a like is
// keyed by (owner, type, tmdbId) — the same identity the feed itself uses.
model ActivityLike {
  id        String   @id @default(uuid())
  userId    String // who liked it
  targetId  String // whose activity it is
  type      String // watched | rewatched | rated | reviewed
  tmdbId    String
  createdAt DateTime @default(now())

  user   User @relation("ActivityLiker", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("ActivityOwner", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, type, tmdbId])
  @@index([targetId, tmdbId])
}

model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

model WatchedItem {
  id        String    @id @default(uuid())
  userId    String
  tmdbId    String
  mediaType MediaType
  watchedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

// One row per SITTING (the diary). WatchedItem stays as the per-title summary
// ("have I seen this at all") that every existing page reads; WatchEvent is the
// detail layer underneath — rewatch counts, the diary timeline, year stats.
// watchedAt = when the film was watched (backdatable); createdAt = when the
// entry was logged (drives feed ordering so backdated logs don't time-travel).
model WatchEvent {
  id        String    @id @default(uuid())
  userId    String
  tmdbId    String
  mediaType MediaType
  isRewatch Boolean   @default(false)
  watchedAt DateTime  @default(now())
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([userId, tmdbId, mediaType])
}

model WatchlistItem {
  id        String    @id @default(uuid())
  userId    String
  tmdbId    String
  mediaType MediaType
  addedAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model Favorite {
  id        String    @id @default(uuid())
  userId    String
  tmdbId    String
  mediaType MediaType
  addedAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model CustomList {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  itemsCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CustomListItem[]
}

model CustomListItem {
  id        String    @id @default(uuid())
  listId    String
  tmdbId    String
  mediaType MediaType
  note      String?
  title     String?
  poster    String?
  year      String?
  addedAt   DateTime  @default(now())

  list CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tmdbId, mediaType])
}

model WatchedEpisode {
  id         String   @id @default(uuid())
  userId     String
  showTmdbId String
  season     Int
  episode    Int
  watchedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, showTmdbId, season, episode])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// A user's computed badges, cached so a profile view doesn't recount someone's
// whole library. Rebuilt from scratch whenever it goes stale rather than being
// nudged by each write — see lib/badge-compute.
model UserBadges {
  userId     String   @id
  badges     Json
  computedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  fromId    String
  type      String
  refId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  from User @relation("NotificationSender", fields: [fromId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FollowRequest {
  id          String   @id @default(uuid())
  requesterId String
  targetId    String
  createdAt   DateTime @default(now())

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("ReceivedRequests", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId])
}

model ReviewComment {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ImportActivity {
  id        String   @id @default(cuid())
  userId    String
  platform  String // 'letterboxd' | 'imdb'
  count     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HiddenActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'watched' | 'rated' | 'reviewed'
  tmdbId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, tmdbId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

// Shared, per-TITLE facts: what a film or show actually IS. Everything else in
// this schema stores only a tmdbId, so genre, language, decade, runtime and
// people existed solely in each browser's cache — which is why World Cinema
// read 0 on other people's profiles. One row per title, shared by every user,
// filled in as titles are looked up. Episodes are deliberately not stored:
// they inherit their show's genre and language via the show id.
model FilmMeta {
  tmdbId      String    @id
  mediaType   MediaType
  title       String
  year        String?
  releaseDate String?
  language    String?
  genres      String[]
  runtime     Int?
  director    String?
  topCast     String[]
  voteAverage Float?

  // Shows only. episodeCount lets the server credit a whole-show mark with its
  // real episode count; showStatus ("Ended", "Returning Series") separates a
  // completed series from one that's merely up to date; showType ("Miniseries",
  // "Scripted") is what tells a mini-series apart. All three already ride along
  // on the TMDB detail call the meta route makes, so they cost nothing extra.
  episodeCount Int?
  showStatus   String?
  showType     String?

  // Episodes per season, keyed by season number: {"1":7,"2":13}. Specials
  // (season 0) are excluded, matching episodeCount. Lets the app say someone
  // finished SEASON ONE rather than "13 / 62" — people talk in seasons, and
  // ticking a season through is already how they get there. Rides along on the
  // same TMDB detail call as the three fields above, so it costs nothing.
  seasonCounts Json?

  updatedAt   DateTime  @updatedAt

  @@index([language])
  @@index([year])
}
